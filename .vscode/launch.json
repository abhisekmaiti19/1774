{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug all unit tests",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/node_modules/mocha/bin/mocha.js",
            "args": [
                "--no-config",
                "--require", "test/setup.cjs",
                "test/unit/**/*.js",
                "--timeout", "999999",
                "--colors"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "name": "Debug current test file",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/node_modules/mocha/bin/mocha.js",
            "args": [
                "--no-config",
                "--require", "test/setup.cjs",
                "${file}",
                "--timeout", "999999",
                "--colors"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "name": "Debug restricted allowance tests (1774)",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/node_modules/mocha/bin/mocha.js",
            "args": [
                "--no-config",
                "--require", "test/setup.cjs",
                "test/unit/app_custom_core/scripts/customObjects/employee/EmployeeRestrictedAllowance.js",
                "--timeout", "999999",
                "--colors"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": ["<node_internals>/**"]
        }
    ]
}